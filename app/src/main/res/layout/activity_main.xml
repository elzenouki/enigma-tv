<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:show_buffering="always"
        app:resize_mode="fit" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/banner_bg"
        android:padding="20dp"
        android:gravity="center"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:text="جاري الاتصال بالرسيفر..." />

    <TextView
        android:id="@+id/numberEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="40dp"
        android:background="@drawable/banner_bg"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text_main"
        android:textSize="48sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Info banner -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="36dp"
        android:background="@drawable/banner_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/bNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="40sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_main"
                android:textSize="26sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/bNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_dim"
                android:textSize="18sp"
                android:singleLine="true" />

            <ProgressBar
                android:id="@+id/bProgress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="1000"
                android:progressTint="@color/accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/bBouquet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:maxWidth="280dp"
            android:singleLine="true"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Channel browser panel -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/panel_bg"
        android:orientation="horizontal"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="الباقات"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/bouquetList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/list_bg"
                android:choiceMode="singleChoice"
                android:divider="@null"
                android:dividerHeight="2dp"
                android:listSelector="@drawable/list_selector"
                android:nextFocusRight="@+id/channelList"
                android:padding="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="540dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channelHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:singleLine="true"
                android:text="القنوات"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/channelList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/list_bg"
                android:choiceMode="singleChoice"
                android:divider="@null"
                android:dividerHeight="2dp"
                android:listSelector="@drawable/list_selector"
                android:nextFocusLeft="@+id/bouquetList"
                android:padding="6dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
